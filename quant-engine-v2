# ==========================================
# 4. CONSENSUS ENGINE
# ==========================================
def build_consensus(all_matches):
    """Finds matches where at least 2 sources agree on the outcome."""
    grouped_matches = {}
    
    for match in all_matches:
        home_norm = normalize_name(match['home'])
        
        # Fuzzy string matching to align different team name spellings
        matched_key = None
        for key in grouped_matches.keys():
            if difflib.SequenceMatcher(None, home_norm, key).ratio() > 0.7:
                matched_key = key
                break
                
        if not matched_key:
            matched_key = home_norm
            grouped_matches[matched_key] = {"display_name": f"{match['home']} vs {match['away']}", "predictions": {}}
            
        pred = match['prediction']
        source = match['source']
        
        if pred not in grouped_matches[matched_key]["predictions"]:
            grouped_matches[matched_key]["predictions"][pred] = []
        grouped_matches[matched_key]["predictions"][pred].append(source)

    # Filter for strict consensus (2 or more sources agree)
    consensus_board = []
    for data in grouped_matches.values():
        for pred, sources in data["predictions"].items():
            if len(sources) >= 2:
                consensus_board.append({
                    "match": data["display_name"],
                    "prediction": pred,
                    "sources": sources
                })
    return consensus_board

