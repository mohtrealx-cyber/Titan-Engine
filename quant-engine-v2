async def fetch_with_scraperapi(url):
    """Uses ScraperAPI and curl_cffi to bypass Cloudflare/bot protection."""
    proxy_url = f"http://scraperapi:{SCRAPER_API_KEY}@proxy-server.scraperapi.com:8001"
    proxies = {"http": proxy_url, "https": proxy_url}
    
    try:
        response = cffi_requests.get(url, proxies=proxies, impersonate="chrome110", timeout=30)
        if response.status_code == 200:
            return response.text
    except Exception as e:
        print(f"ScraperAPI failed for {url}: {e}")
    return None

