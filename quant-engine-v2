def send_telegram_message(text):
    """Sends a formatted message to the designated Telegram channel."""
    if not TELEGRAM_TOKEN or not CHAT_ID:
        print("Telegram credentials missing. Cannot send message.")
        return
    
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {
        "chat_id": CHAT_ID,
        "text": text,
        "parse_mode": "Markdown"
    }
    try:
        sync_requests.post(url, json=payload)
    except Exception as e:
        print(f"Failed to send Telegram message: {e}")

def normalize_name(name):
    """Standardizes team names for better matching."""
    return str(name).lower().strip().replace(" fc", "").replace(" fk", "").replace(" united", " utd")

