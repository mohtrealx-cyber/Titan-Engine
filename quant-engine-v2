# 5. GEMINI AI OPTIMIZER
# ==========================================
def generate_ai_tickets(consensus_matches):
    """Sends strict consensus matches to Gemini to formulate 3 betting tiers."""
    url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={GEMINI_API_KEY}"
    
    prompt = f"""
    You are an expert sports quantitative analyst. I have a list of football matches where multiple prediction algorithms agree.
    Data: {json.dumps(consensus_matches)}
    
    Please organize these into 3 optimized betslips:
    1. Safe Tier (Highest confidence)
    2. Balanced Tier (Good risk/reward)
    3. Value Tier (High odds)
    
    Return ONLY the formatted text for Telegram.
    """
    
    payload = {"contents": [{"parts": [{"text": prompt}]}]}
    try:
        response = sync_requests.post(url, json=payload).json()
        return response['candidates'][0]['content']['parts'][0]['text']
    except Exception as e:
        print(f"Gemini API Error: {e}")
        return "⚠️ Gemini AI failed to generate tickets."

