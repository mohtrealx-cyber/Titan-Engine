# 6. MAIN PIPELINE
# ==========================================
async def main():
    print(f"--- Starting Quant Engine run at {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} ---")
    
    # 1. Run all scrapers concurrently
    results = await asyncio.gather(
        scrape_windrawwin(),
        scrape_statarea(),
        scrape_vitibet(),
        scrape_predictz()
    )
    
    # Flatten the list of all matches
    all_matches = [match for site_matches in results for match in site_matches]
    
    # 2. Build the consensus board
    consensus_matches = build_consensus(all_matches)
    
    # 3. Status Report Generation
    status_report = f"\n\n⚙️ **SCRAPER STATUS** ⚙️\n"
    status_report += f"↳ WinDrawWin: {scraper_stats.windrawwin['status']} ({scraper_stats.windrawwin['upcoming']} Upcoming | {scraper_stats.windrawwin['played']} Played)\n"
    status_report += f"↳ Statarea: {scraper_stats.statarea['status']} ({scraper_stats.statarea['upcoming']} Upcoming | {scraper_stats.statarea['played']} Played)\n"
    status_report += f"↳ Vitibet: {scraper_stats.vitibet['status']} ({scraper_stats.vitibet['upcoming']} Upcoming | {scraper_stats.vitibet['played']} Played)\n"
    status_report += f"↳ PredictZ: {scraper_stats.predictz['status']} ({scraper_stats.predictz['upcoming']} Upcoming | {scraper_stats.predictz['played']} Played)\n"
    
    # 4. Handle Low Volume (No Bet Day)
    if len(consensus_matches) < 3:
        status_report += "↳ AI_Status: 🟡 Skipped (Low Volume)"
        msg = f"🚨 **SYSTEM OVERRIDE: LOW VOLUME (NO BET DAY)** 🚨\n\nThe engine only found **{len(consensus_matches)}** matches that passed the strict consensus filter today.\n\n"
        msg += "🛑 **Verdict: NOT SAFE TO BET.** The volume is too low to properly diversify risk across three tickets. Preserve your bankroll for a better board.\n\n"
        msg += "*(Matches found for monitoring purposes only:)*\n"
        
        for match in consensus_matches:
            sources_str = " + ".join(match['sources'])
            msg += f"• **{match['match']}** ➔ {match['prediction']}\n  ↳ 🔍 Backed by: `{sources_str}`\n\n"
            
        send_telegram_message(msg + status_report)
        print("Low volume. Message sent. Exiting.")
        return

    # 5. Ask Gemini to generate tickets
    status_report += "↳ AI_Status: 🟢 Generated Tickets"
    ai_tickets = generate_ai_tickets(consensus_matches)
    
    # 6. Send Final Output
    final_message = f"🎯 **QUANT ENGINE CONSENSUS TICKETS** 🎯\n\n{ai_tickets}\n{status_report}"
    send_telegram_message(final_message)
    
    # 7. Save pending tickets to memory for tomorrow's settlement
    with open(MEMORY_FILE, 'w') as f:
        json.dump(consensus_matches, f, indent=4)
    print(f"Saved {len(consensus_matches)} matches to {MEMORY_FILE}")

if __name__ == "__main__":
    asyncio.run(main())
